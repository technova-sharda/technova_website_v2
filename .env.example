# Copy to .env and fill in. Never commit .env.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct Postgres connection, only used by scripts
DATABASE_URL=

# Auth.js (Google sign-in). AUTH_SECRET: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=

# Payments (Razorpay), only needed for paid events
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Event reminder cron: any long random string (`openssl rand -hex 32`).
# Same value in Vercel and in the GitHub repository secret CRON_SECRET.
CRON_SECRET=

# NVIDIA API (Ask Technova, AI report summaries, feedback themes): build.nvidia.com
NAPI_KEY=
# Optional overrides (defaults shown)
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_THINKING=off

# Optional: where hackathon team-update notifications go (default technova@sharda.ac.in)
# ADMIN_NOTIFICATION_EMAIL=

# Optional: who can open /admin/logs (comma-separated emails). Default: the Tech Lead only.
AUDIT_LOG_VIEWERS=
